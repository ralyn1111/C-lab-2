
#include <stdio.h>
#include <stdlib.h>

void reverse(double array[], int size) {
    int i;
    i = 0;
    for (; i<size/2; i++) {
        double temp;
        temp = array[i];
        array[i] = array[size-i-1];
        array[size-i-1] = temp;
    }
}

int main() {
    int size;
    double *array;
    int i;
    printf("Enter size of array: ");
    scanf("%d", &size);
    array = (double *)malloc(size * sizeof(double));
    if (array == NULL) {
        printf("Failed to allocate memory!\n");
        return 1;
    }
    i = 0;
    for (; i<size; i++) {
        printf("Enter an array element: ");
        scanf("%lf", &array[i]);
    }
    reverse(array, size);
    printf("Reversed array: ");
    i = 0;
    for (; i<size; i++) {
        printf("%g ", array[i]);
    }
    free(array);
}
